#!name=AI 信息
#!desc=DeepSeek 余额、CCH 额度与并发 session、Sub2API 多站点余额
#!category=System
#!system=ios

#!arguments=deepseek_key,deepseek_query_interval:3600,deepseek_notify_balance:5,deepseek_warn_balance:5,deepseek_daily_notify:true,deepseek_icon:yensign.circle,deepseek_icon_color:4D6BFE,cch_url,cch_api_key,cch_query_interval:60,cch_icon:chart.bar.fill,cch_icon_color:34C759,sub2api_endpoints,sub2api_title:API 中转站,sub2api_query_interval:300,sub2api_warn_balance:1,sub2api_notify_balance:1,sub2api_daily_notify:false,sub2api_icon:dollarsign.circle,sub2api_icon_color:5B8DEF
#!arguments-desc=DeepSeek:\n    ├ API Key：platform.deepseek.com → API keys\n    ├ 查询间隔默认 3600 秒，提醒阈值默认 5\n    └ 日报默认开启（每天 23:50）\n\nCCH:\n    ├ 地址：CCH HTTPS 地址，不带末尾斜杠\n    ├ API Key：普通用户 Key，需 read 权限\n    └ 展示总额度与并发 session，刷新间隔默认 60 秒\n\nSub2API:\n    ├ 站点：一行一个，名称@域名=Key，多个用竖线分隔\n    ├ 例：kcne@api.example.com=sk-xxx|backup@api.example.net=sk-yyy\n    ├ 名称可省略，省略时显示域名；最多显示 5 个\n    └ 刷新间隔默认 300 秒，提醒阈值默认 1\n\n其余参数:\n    ├ 各面板图标使用 SF Symbol 名称与六位 HEX 颜色\n    └ 提醒阈值、日报开关按面板分别设置，填 0 / false 即关闭

[Panel]
Sub2API 中转站 = title="{{{sub2api_title}}}",content="正在获取...",style=info,script-name=sub2api-balance-panel,update-interval={{{sub2api_query_interval}}}
CCH 额度 = title="CCH",content="正在获取...",style=info,script-name=cch-monitor-panel,update-interval={{{cch_query_interval}}}
DeepSeek 余额 = title="DeepSeek",content="正在获取...",style=info,script-name=deepseek-balance-panel,update-interval={{{deepseek_query_interval}}}

[Script]
sub2api-balance-panel = type=generic,script-path=https://raw.githubusercontent.com/LucaLin233/Proxy/main/surge/scripts/sub2api_balance.js,timeout=30,argument="sub2api_endpoints={{{sub2api_endpoints}}}&sub2api_title={{{sub2api_title}}}&sub2api_warn_balance={{{sub2api_warn_balance}}}&sub2api_notify_balance={{{sub2api_notify_balance}}}&sub2api_icon={{{sub2api_icon}}}&sub2api_icon_color={{{sub2api_icon_color}}}"
sub2api-balance-daily = type=cron,cronexp="52 23 * * *",wake-system=true,timeout=30,script-path=https://raw.githubusercontent.com/LucaLin233/Proxy/main/surge/scripts/sub2api_balance.js,argument="sub2api_endpoints={{{sub2api_endpoints}}}&sub2api_title={{{sub2api_title}}}&sub2api_daily_notify={{{sub2api_daily_notify}}}&mode=daily"
cch-monitor-panel = type=generic,script-path=https://raw.githubusercontent.com/LucaLin233/Proxy/main/surge/scripts/cch_monitor.js,timeout=30,argument="cch_url={{{cch_url}}}&cch_api_key={{{cch_api_key}}}&cch_icon={{{cch_icon}}}&cch_icon_color={{{cch_icon_color}}}"
deepseek-balance-panel = type=generic,script-path=https://raw.githubusercontent.com/LucaLin233/Proxy/main/surge/scripts/deepseek_balance.js,timeout=30,argument="deepseek_key={{{deepseek_key}}}&deepseek_notify_balance={{{deepseek_notify_balance}}}&deepseek_warn_balance={{{deepseek_warn_balance}}}&deepseek_icon={{{deepseek_icon}}}&deepseek_icon_color={{{deepseek_icon_color}}}"
deepseek-balance-daily = type=cron,cronexp="50 23 * * *",wake-system=true,timeout=30,script-path=https://raw.githubusercontent.com/LucaLin233/Proxy/main/surge/scripts/deepseek_balance.js,argument="deepseek_key={{{deepseek_key}}}&deepseek_daily_notify={{{deepseek_daily_notify}}}&mode=daily"
