#!name=Server 信息
#!desc=AWS Lightsail 实例流量与 Peekabo 服务器流量、到期信息，合并为一个面板
#!category=System
#!system=ios

#!arguments=server_query_interval:21600,server_daily_notify:true,server_icon:cloud,server_icon_color:FF9900,lightsail_ak,lightsail_sk,lightsail_region:ap-east-1|ap-northeast-1,lightsail_notify_percent:80,lightsail_ip_mode:mask,peekabo_id,peekabo_token,peekabo_notify_days:3
#!arguments-desc=AWS Lightsail:\n    ├ 密钥：AWS 控制台 → IAM → 只读策略（lightsail:GetInstances / GetBundles / GetInstanceMetricData）→ 创建访问密钥\n    └ 区域默认 ap-east-1|ap-northeast-1，多个用竖线分隔\n\nPeekabo:\n    ├ Server ID：控制面板服务器页面 URL 中 /server/ 后的内容\n    └ API Token：Account → API\n\n其余参数:\n    ├ 面板刷新间隔默认 21600 秒（6 小时）\n    ├ 日报默认开启；每天 23:55 推送一条，含 Lightsail 与 Peekabo 两段\n    ├ 提醒阈值、通知天数填 0 即关闭\n    └ 图标使用 SF Symbol 名称与六位 HEX 颜色

[Panel]
服务器概览 = title="服务器概览",content="正在获取...",style=info,script-name=server-overview-panel,update-interval={{{server_query_interval}}}

[Script]
server-overview-panel = type=generic,script-path=https://raw.githubusercontent.com/LucaLin233/Proxy/main/surge/scripts/server_overview.js,timeout=10,argument="lightsail_ak={{{lightsail_ak}}}&lightsail_sk={{{lightsail_sk}}}&lightsail_region={{{lightsail_region}}}&lightsail_notify_percent={{{lightsail_notify_percent}}}&lightsail_ip_mode={{{lightsail_ip_mode}}}&peekabo_id={{{peekabo_id}}}&peekabo_token={{{peekabo_token}}}&peekabo_notify_days={{{peekabo_notify_days}}}&server_icon={{{server_icon}}}&server_icon_color={{{server_icon_color}}}"
server-overview-daily = type=cron,cronexp="55 23 * * *",wake-system=true,timeout=30,script-path=https://raw.githubusercontent.com/LucaLin233/Proxy/main/surge/scripts/server_overview.js,argument="lightsail_ak={{{lightsail_ak}}}&lightsail_sk={{{lightsail_sk}}}&lightsail_region={{{lightsail_region}}}&lightsail_ip_mode={{{lightsail_ip_mode}}}&peekabo_id={{{peekabo_id}}}&peekabo_token={{{peekabo_token}}}&server_daily_notify={{{server_daily_notify}}}&mode=daily"
