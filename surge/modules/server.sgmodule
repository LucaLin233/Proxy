#!name=Server 信息
#!desc=AWS Lightsail 实例流量与 Peekabo 服务器流量、到期信息
#!category=System
#!system=ios

#!arguments=lightsail_ak,lightsail_sk,lightsail_region:ap-east-1|ap-northeast-1,lightsail_query_interval:21600,lightsail_notify_percent:80,lightsail_ip_mode:mask,lightsail_icon:cloud,lightsail_icon_color:FF9900,lightsail_daily_notify:true,peekabo_id,peekabo_token,peekabo_query_interval:86400,peekabo_notify_days:3,peekabo_icon:xserve,peekabo_icon_color:3B82F6
#!arguments-desc=AWS Lightsail:\n    ├ 密钥：AWS 控制台 → IAM → 只读策略（lightsail:GetInstances / GetBundles / GetInstanceMetricData）→ 创建访问密钥\n    └ 区域默认 ap-east-1|ap-northeast-1，多个用竖线分隔\n\nPeekabo:\n    ├ Server ID：控制面板服务器页面 URL 中 /server/ 后的内容\n    └ API Token：Account → API\n\n查询间隔（秒）:\n    ├ Lightsail 默认 21600（6 小时）\n    └ Peekabo 默认 86400（每天一次）\n\n其余参数:\n    ├ 提醒阈值、通知天数填 0 即关闭\n    └ 图标使用 SF Symbol 名称与六位 HEX 颜色

[Panel]
Lightsail = title="Lightsail",content="正在获取...",style=info,script-name=lightsail-traffic-panel,update-interval={{{lightsail_query_interval}}}
Peekabo = title="Peekabo",content="正在获取...",style=info,script-name=peekabo-traffic-panel,update-interval={{{peekabo_query_interval}}}

[Script]
lightsail-traffic-panel = type=generic,script-path=https://raw.githubusercontent.com/LucaLin233/Proxy/main/surge/scripts/lightsail_traffic.js,timeout=60,argument="ak={{{lightsail_ak}}}&sk={{{lightsail_sk}}}&region={{{lightsail_region}}}&notify-percent={{{lightsail_notify_percent}}}&ip-mode={{{lightsail_ip_mode}}}&icon={{{lightsail_icon}}}&icon-color={{{lightsail_icon_color}}}"
lightsail-traffic-daily = type=cron,cronexp="55 23 * * *",wake-system=true,timeout=60,script-path=https://raw.githubusercontent.com/LucaLin233/Proxy/main/surge/scripts/lightsail_traffic.js,argument="ak={{{lightsail_ak}}}&sk={{{lightsail_sk}}}&region={{{lightsail_region}}}&ip-mode={{{lightsail_ip_mode}}}&daily-notify={{{lightsail_daily_notify}}}&mode=daily"
peekabo-traffic-panel = type=generic,timeout=30,script-path=https://raw.githubusercontent.com/LucaLin233/Proxy/main/surge/scripts/peekabo_traffic.js,argument="id={{{peekabo_id}}}&token={{{peekabo_token}}}&notify-days={{{peekabo_notify_days}}}&icon={{{peekabo_icon}}}&icon-color={{{peekabo_icon_color}}}"
