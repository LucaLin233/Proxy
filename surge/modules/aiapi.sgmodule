#!name=AI 中转站
#!desc=CCH / CCHP 站点余额，按 CCHP 优先级排序（每轮实取，实时生效），Clouder 走 CCH
#!category=System
#!system=ios

#!arguments=aiapi_query_interval:600,aiapi_daily_notify:true,aiapi_icon:dollarsign.circle,aiapi_icon_color:5B8DEF,cch_endpoints,cch_admin_max:8,cch_row_width:38,cch_cmdcode_month_cap:70,cch_quota_interval:600,cch_show_limits:false,aiapi_cchp_single_account:true
#!arguments-desc=CCH:\n    ├ 站点：名称@地址=凭据:模式[:优先级]，多个用竖线分隔；模式直接接在凭据后面、不加括号，省略即 user\n    ├ 模式：user 普通用户 Key | cookie 会话 auth-token | admin 管理员令牌 | login Key 自动登录 | cchp CCHP 管理令牌 | cmdcode CommandCode 限额\n    ├ admin 列本站各上游余额：按厂商归并，名称取供应商名的品牌部分；CCH 已用各上游自己的密钥查好，面板不接触上游密钥\n    ├ user/cookie/login 列该站账户余额，与上游余额并列显示\n    ├ 例：cch@cch.example.com=<管理员令牌>:admin|clouder@cc2.example.com=<用户 Key>:user\n    ├ 例：CommandCode@api.commandcode.ai=<CommandCode API Key>:cmdcode:5\n    ├ cmdcode 分两行：第 1 行站名 + 成功率/TTFT（取自 CCHP provider-health，按域名匹配），第 2 行 5H / W / M 剩余百分比；M 按 cch_cmdcode_month_cap（默认 70 美元）折算，上限非法时写剩余金额；限额缓存 cch_quota_interval 秒，取数失败沿用缓存并提示\n    ├ 优先级可写小数；不写则按域名/名称匹配 CCHP 或主 CCH 的厂商优先级（每轮实取，实时生效）\n    ├ 行序：优先级升序（数值越小越靠前）；没有优先级的行排在后面，按 CommandCode → Clouder → Kcne → Air 兜底（不在表里的排最后），同序再按名称与配置顺序；不按余额排序\n    ├ cch_admin_max 是最多显示的行数，cch_row_width 是每行宽度（默认 38）\n    ├ cch_show_limits 打开后额外展示供应商限额（5 小时/日/周/月用量）\n    └ 详细说明见仓库 docs/aiapi-panel.md\n\nCCHP:\n    ├ 写法：名称@地址=管理令牌:cchp，组织由 /api/account/org-tree 自动获取\n    ├ 迁移：用 CCHP 条目替换原来的主站 admin 条目，Clouder 仍保留 user/cookie/login 条目；两者同时保留会出现重复行\n    ├ 例：CCHP@cchp.example.com=<管理令牌>:cchp|Clouder@cc2.example.tech=<用户 Key>:user\n    ├ 显示余额 + 今日用量 + 供应商健康，不查供应商限额；没有任何 active key 的 provider 不显示（keys/page 取不全时不据此隐藏）；Mi（miapi）不展示\n    ├ Clouder 的余额仍由 CCH 站点提供；站点名等于 provider 名或品牌，或站点域名与 provider 的 website_url 一致时，沿用其 key 优先级\n    ├ aiapi_cchp_single_account 默认开启：每个 provider 只刷一把代表 key、只显示该账户金额；多账户 provider 需要合计时设 false，改为逐把 active key 刷新并按 totals 聚合\n    ├ 上游余额接口有频率限制：每把 key 每轮只刷一次、失败不重试；刷新不全时沿用服务端缓存值并在底部提示\n    └ 总预算约 27 秒，超时的部分降级并提示「部分请求超时」\n\n其余参数:\n    ├ 面板刷新间隔默认 600 秒\n    ├ 日报默认开启；每天 23:50 推送一条同样的列表；填 false 即关闭\n    └ 图标使用 SF Symbol 名称与六位 HEX 颜色

[Panel]
API 中转站概览 = title="API 中转站概览",content="正在获取...",style=info,script-name=aiapi-relay-panel,update-interval={{{aiapi_query_interval}}}

[Script]
aiapi-relay-panel = type=generic,script-path=https://raw.githubusercontent.com/LucaLin233/Proxy/main/surge/scripts/aiapi_relay.js,timeout=30,argument="cch_endpoints={{{cch_endpoints}}}&cch_admin_max={{{cch_admin_max}}}&cch_row_width={{{cch_row_width}}}&cch_cmdcode_month_cap={{{cch_cmdcode_month_cap}}}&cch_quota_interval={{{cch_quota_interval}}}&cch_show_limits={{{cch_show_limits}}}&aiapi_icon={{{aiapi_icon}}}&aiapi_icon_color={{{aiapi_icon_color}}}&aiapi_cchp_single_account={{{aiapi_cchp_single_account}}}"
aiapi-relay-daily = type=cron,cronexp="50 23 * * *",wake-system=true,timeout=30,script-path=https://raw.githubusercontent.com/LucaLin233/Proxy/main/surge/scripts/aiapi_relay.js,argument="cch_endpoints={{{cch_endpoints}}}&cch_admin_max={{{cch_admin_max}}}&cch_row_width={{{cch_row_width}}}&cch_cmdcode_month_cap={{{cch_cmdcode_month_cap}}}&cch_quota_interval={{{cch_quota_interval}}}&cch_show_limits={{{cch_show_limits}}}&aiapi_daily_notify={{{aiapi_daily_notify}}}&aiapi_cchp_single_account={{{aiapi_cchp_single_account}}}&mode=daily"
