#!name=AI 中转站
#!desc=CCH / CCHP 站点余额，按优先级排序，Clouder 走 CCH
#!category=System
#!system=ios

#!arguments=aiapi_query_interval:600,aiapi_daily_notify:true,aiapi_icon:dollarsign.circle,aiapi_icon_color:5B8DEF,cch_endpoints,cch_admin_max:8,cch_row_width:38,cch_quota_interval:600,cch_show_limits:false,aiapi_cchp_single_account:true
#!arguments-desc=CCH:\n    ├ 站点：一行一个，名称@地址=凭据:模式，多个用竖线分隔\n    ├ 模式：直接接在凭据后面，不要加括号，如 =<凭据>:admin；省略即 user\n    ├ user 普通用户 Key | cookie 会话 auth-token | admin 管理员令牌 | login Key 自动登录 | cchp CCHP 管理令牌\n    ├ admin 模式列本站各上游余额：CCH 已用各上游自己的密钥查好，面板不接触上游密钥\n    ├ user/cookie/login 模式列该站账户余额，与上游余额并列显示\n    ├ 例：cch@cch.example.com=<管理员令牌>:admin|clouder@cc2.example.com=<用户 Key>:user\n    ├ 站点末尾可再加优先级（=凭据:模式:优先级，可小数），不写则按域名/名称匹配主 CCH 的厂商优先级\n    ├ 上游按厂商归并（同一站点的多把密钥合成一行），名称取供应商名的品牌部分\n    ├ 每行只显示余额，按 CCH 优先级升序排（同级按余额升序）；查不到余额的上游不列出\n    ├ cch_show_limits 打开后额外展示供应商限额（5 小时/日/周/月用量）\n    └ 额度缓存默认 600 秒，与面板刷新一致\n\nCCHP:\n    ├ 写法：名称@地址=管理令牌:cchp，地址填 CCHP 站点\n    ├ 迁移：用 CCHP 条目替换原来的主站 admin 条目，Clouder 仍保留 user/cookie/login 条目；不要同时保留原主站，否则同一个站会出现两行\n    ├ 例：CCHP@cchp.example.com=<管理令牌>:cchp|Clouder@cc2.example.tech=<用户 Key>:user\n    ├ 组织由 /api/account/org-tree 自动获取\n    ├ 按各 provider 的 key 优先级升序排（无 active key 时取全部 key 的最小值），同级按余额升序\n    ├ Clouder 不在此模式取余额，仍按 CCH 站点填写（user/cookie/login）；站点名须等于 provider 名或品牌（如 Clouder），或站点域名与 provider 的 website_url 域名一致，否则该站排最后（也可在站点末尾手写优先级）\n    ├ 显示余额 + 今日用量 + 供应商健康（status=ok 才占行，unlimited 显示「不限量」，多币种并列显示如 余额 $2.00 + ¥70.00），不查供应商限额\n    ├ Mi（miapi）与原 CCH 一致不展示，也不查 keys、不刷新\n    ├ aiapi_cchp_single_account 默认开启：每个 provider 只刷一把代表 key（active keyIds 去重升序第一）并只显示该账户金额；多账户 provider 需要合计时显式设 false\n    ├ 余额刷新：默认单账户模式每个 provider 只刷代表 key；关闭 aiapi_cchp_single_account 后对每个 provider 的每把 active key 各调一次 ?refresh=true 复查（同一上游账户多把 key 只刷一把会让读数不一致、被重复计入总额），再取一次列表拿聚合余额（Clouder 不刷新，只保留 key 优先级用于排序）\n    ├ 刷新不全时沿用列表里的服务端缓存值：全部失败或被预算跳过提示「余额未刷新，来自服务端缓存」，部分 provider 未刷新（含没有 active key）提示「部分余额未刷新」，与超时提示去重（超时优先）；列表请求本身失败才回退上次快照并提示「CCHP 余额来自缓存」\n    ├ 上游余额接口有频率限制：单账户模式每个 provider 一次、关闭后每把 active key 一次、失败不重试；org 与 key 优先级仍缓存 600 秒（受 cch_quota_interval 控制）\n    └ 总耗时约 27 秒即停止派发与等待（在途请求无法取消，晚到的响应丢弃）并提示「部分请求超时」\n\n其余参数:\n    ├ 面板刷新间隔默认 600 秒\n    ├ 日报默认开启；每天 23:50 推送一条同样的列表；填 false 即关闭\n    └ 图标使用 SF Symbol 名称与六位 HEX 颜色

[Panel]
API 中转站概览 = title="API 中转站概览",content="正在获取...",style=info,script-name=aiapi-relay-panel,update-interval={{{aiapi_query_interval}}}

[Script]
aiapi-relay-panel = type=generic,script-path=https://raw.githubusercontent.com/LucaLin233/Proxy/main/surge/scripts/aiapi_relay.js,timeout=30,argument="cch_endpoints={{{cch_endpoints}}}&cch_admin_max={{{cch_admin_max}}}&cch_row_width={{{cch_row_width}}}&cch_quota_interval={{{cch_quota_interval}}}&cch_show_limits={{{cch_show_limits}}}&aiapi_icon={{{aiapi_icon}}}&aiapi_icon_color={{{aiapi_icon_color}}}&aiapi_cchp_single_account={{{aiapi_cchp_single_account}}}"
aiapi-relay-daily = type=cron,cronexp="50 23 * * *",wake-system=true,timeout=30,script-path=https://raw.githubusercontent.com/LucaLin233/Proxy/main/surge/scripts/aiapi_relay.js,argument="cch_endpoints={{{cch_endpoints}}}&cch_admin_max={{{cch_admin_max}}}&cch_row_width={{{cch_row_width}}}&cch_quota_interval={{{cch_quota_interval}}}&cch_show_limits={{{cch_show_limits}}}&aiapi_daily_notify={{{aiapi_daily_notify}}}&aiapi_cchp_single_account={{{aiapi_cchp_single_account}}}&mode=daily"
